{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Npgsql": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },
  "Cabinet": {
    "TimeZone": "America/Toronto"
  }
}
