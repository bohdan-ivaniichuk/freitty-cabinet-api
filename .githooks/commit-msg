#!/usr/bin/env bash
# Git commit-msg hook — reject AI-attribution trailers in any commit, however it is made
# (terminal, IDE or agent). Enable once per clone: git config core.hooksPath .githooks

pattern='co-authored-by:.*(claude|anthropic)|claude-session:|claude\.ai/code|generated (with|by) \[?claude|🤖 generated'

if grep -Eiq "$pattern" "$1"; then
  echo "commit-msg: AI-attribution trailer found in the commit message — remove it." >&2
  grep -Ein "$pattern" "$1" >&2
  exit 1
fi
